<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B1020">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GOLDEN MIND AI" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Safety-first trading assistant" android:textColor="#9CA3AF" android:textSize="14sp"
            android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/mode" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MODE  •  PAPER / TESTNET" android:textColor="#7DD3FC" android:textSize="14sp"
            android:textStyle="bold" android:background="#172554" android:padding="14dp" android:layout_marginTop="22dp"/>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="System ready" android:textColor="#D1D5DB" android:textSize="16sp"
            android:background="#111827" android:padding="18dp" android:layout_marginTop="14dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Backend" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
            android:layout_marginTop="24dp"/>
        <EditText android:id="@+id/baseUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="http://192.168.x.x:8000" android:text="http://10.0.2.2:8000"
            android:textColor="#FFFFFF" android:hintTextColor="#6B7280" android:inputType="textUri"
            android:singleLine="true" android:padding="14dp"/>
        <EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Username" android:textColor="#FFFFFF" android:hintTextColor="#6B7280"
            android:inputType="text" android:singleLine="true" android:padding="14dp"/>
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Password" android:textColor="#FFFFFF" android:hintTextColor="#6B7280"
            android:inputType="textPassword" android:singleLine="true" android:padding="14dp"/>
        <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="CONNECT TO BACKEND" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Quick actions" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
            android:layout_marginTop="24dp"/>
        <Button android:id="@+id/testnet" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="TESTNET CONNECTION CHECK" android:layout_marginTop="12dp"/>
        <Button android:id="@+id/paper" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="START PAPER MODE" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/safety" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="RUN SAFETY CHECK" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Log&#10;• Live trading disabled&#10;• No API keys stored&#10;• Local UI initialized"
            android:textColor="#A7F3D0" android:textSize="14sp" android:background="#111827"
            android:padding="18dp" android:layout_marginTop="20dp"/>
    </LinearLayout>
</ScrollView>